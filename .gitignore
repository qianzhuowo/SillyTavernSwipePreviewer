# This plugin runs directly from its root JS/MJS/CSS sources.
# Keep runtime modules (including *.mjs), manifest.json, docs, manifests and lockfiles.
# Do not add blanket rules for *.mjs, *.js, *.json or images.

# Downloaded dependencies and local package caches (keep manifests and lockfiles).
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml
.pnp.*

# Generated build/package output; none is required by the current plugin entry.
dist/
build/
out/
/target/
/release/
/packages-output/
*.tsbuildinfo
*.tgz
*.exe
*.msi
*.msix
*.dmg
*.AppImage
*.apk
*.aab

# Local scratch files and temporary output.
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# Machine-specific editor configuration and local environment secrets.
/.idea/
/.vscode/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local Python tooling, virtual environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local-only tests, mock hosts, performance scripts and generated reports/screenshots.
# Keep these on disk for development; do not include them in the published plugin.
# Previously tracked tests must also be removed from the index with git rm --cached.
tests/
test/
__tests__/
artifacts/
*.test.js
*.test.mjs
*.test.cjs
*.spec.js
*.spec.mjs
*.spec.cjs

# Test/tool caches and generated coverage reports.
.cache/
.parcel-cache/
.vite/
.turbo/
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
.playwright/
/playwright/.cache/
/junit.xml
/junit-*.xml
/coverage-final.json
/lcov.info
.eslintcache
.stylelintcache

# Local logs and operating-system metadata.
*.log
.DS_Store
Thumbs.db
desktop.ini
